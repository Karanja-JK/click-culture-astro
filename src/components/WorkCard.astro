---
import { ArrowUpRight } from 'lucide-react';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  client: string;
  descriptor?: string;
  metric: string;
  tag: string;
  initials: string;
  tone?: "blue" | "dark" | "soft";
  to?: string;
  image?: ImageMetadata;
}
const { client, descriptor, metric, tag, initials, tone = "blue", to = "/work", image } = Astro.props;

const toneClass =
  tone === "dark" ? "from-surface-2 to-base"
  : tone === "soft" ? "from-accent-soft to-surface-2"
  : "from-accent/40 to-surface-2";
---
<a href={to} data-reveal class="group block">
  <div class={`relative aspect-square w-full overflow-hidden rounded-2xl border border-border bg-gradient-to-br ${toneClass} transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:border-accent`}>
    {image ? (
      <Image src={image} loading="lazy" class="absolute inset-0 h-full w-full object-cover" alt={client} />
    ) : (
      <div class="absolute inset-0 flex items-center justify-center">
        <span class="font-display text-[clamp(5rem,12vw,9rem)] font-medium leading-none text-text-primary/10 transition-all duration-700 group-hover:text-text-primary/20">
          {initials}
        </span>
      </div>
    )}
    <div class="absolute left-6 top-6 inline-flex items-center gap-2 rounded-full border border-border bg-base/60 px-3 py-1 text-[10px] font-medium uppercase tracking-[0.18em] text-text-muted backdrop-blur">
      {tag}
    </div>
    <div class="absolute right-6 top-6 inline-flex h-10 w-10 items-center justify-center rounded-full border border-border bg-base/60 text-text-primary backdrop-blur transition-all duration-500 group-hover:bg-accent group-hover:border-accent">
      <ArrowUpRight size={16} />
    </div>
  </div>
  <div class="mt-6 flex items-start justify-between gap-6">
    <div>
      <h3 class="font-display text-xl font-medium text-text-primary">{client}</h3>
      {descriptor && <p class="mt-1 text-sm text-text-muted">{descriptor}</p>}
      <p class="mt-1 text-sm text-text-muted">{metric}</p>
    </div>
  </div>
</a>
