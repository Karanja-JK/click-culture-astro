---
import Container from './Container.astro';
import { Button } from './Button';
import { Mail, Phone } from 'lucide-react';
---
<section class="border-t border-border py-24 md:py-32">
  <Container class="grid gap-16 lg:grid-cols-[1.2fr_1fr] lg:items-center">
    <div data-reveal class="space-y-8">
      <p class="text-xs uppercase tracking-[0.22em] text-text-muted">Let's talk</p>
      <h2 class="font-display text-[clamp(2.75rem,6vw,5rem)] font-medium leading-[1.02] tracking-tight text-text-primary">
        Let's build something <br />
        <span class="text-accent-hover">that works.</span>
      </h2>
      <Button magnetic asChildHref="/contact" client:visible>
        Book a Strategy Call
      </Button>
    </div>
    <div data-reveal class="space-y-4 rounded-3xl border border-border bg-surface/40 p-8">
      <p class="text-xs uppercase tracking-[0.22em] text-text-muted">Prefer to talk it through?</p>
      <div class="space-y-3 pt-2">
        <a href="mailto:marketing@clickculturedigital.com" class="group flex items-center gap-4 rounded-xl border border-border bg-surface p-5 transition-colors hover:border-accent">
          <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-base transition-colors group-hover:bg-accent">
            <Mail size={16} className="text-accent-hover transition-colors group-hover:text-text-primary" />
          </span>
          <span class="flex flex-col">
            <span class="text-xs uppercase tracking-[0.18em] text-text-muted">Email</span>
            <span class="text-sm text-text-primary">marketing@clickculturedigital.com</span>
          </span>
        </a>
        <a href="tel:+254727808264" class="group flex items-center gap-4 rounded-xl border border-border bg-surface p-5 transition-colors hover:border-accent">
          <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-base transition-colors group-hover:bg-accent">
            <Phone size={16} className="text-accent-hover transition-colors group-hover:text-text-primary" />
          </span>
          <span class="flex flex-col">
            <span class="text-xs uppercase tracking-[0.18em] text-text-muted">Phone</span>
            <span class="text-sm text-text-primary">+254 727 808 264</span>
          </span>
        </a>
      </div>
    </div>
  </Container>
</section>
