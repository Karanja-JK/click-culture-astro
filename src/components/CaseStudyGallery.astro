---
import { Image } from 'astro:assets';
import Container from './Container.astro';

interface GalleryGroup {
  name: string;
  images: ImageMetadata[];
}
interface Props {
  images?: ImageMetadata[];
  groups?: GalleryGroup[];
}
const { images, groups } = Astro.props;
const hasContent = (images && images.length > 0) || (groups && groups.length > 0);
---
{hasContent && (
  <section class="border-b border-border section-light py-24 md:py-32">
    <Container>
      <p data-reveal class="mb-16 text-xs uppercase tracking-[0.22em] text-text-muted">Gallery</p>
      {groups && groups.length > 0 ? (
        <div class="flex flex-col gap-16">
          {groups.map((group) => (
            <div data-reveal>
              <h3 class="mb-6 font-display text-2xl font-medium text-text-primary">{group.name}</h3>
              <div class="grid grid-cols-2 gap-4 md:grid-cols-3 md:gap-6">
                {group.images.map((img, i) => (
                  <div class="group relative aspect-[4/5] overflow-hidden rounded-xl border border-border bg-surface">
                    <Image
                      src={img}
                      layout="constrained"
                      width={1000}
                      quality={80}
                      format="webp"
                      loading="lazy"
                      class="absolute inset-0 h-full w-full object-contain transition-transform duration-500 ease-out group-hover:scale-105"
                      alt={`${group.name} photo ${i + 1}`}
                    />
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
      ) : (
        <div class="grid grid-cols-2 gap-4 md:grid-cols-3 md:gap-6">
          {images!.map((img, i) => (
            <div class="group relative aspect-[4/5] overflow-hidden rounded-xl border border-border bg-surface">
              <Image
                src={img}
                layout="constrained"
                width={1000}
                quality={80}
                format="webp"
                loading="lazy"
                class="absolute inset-0 h-full w-full object-contain transition-transform duration-500 ease-out group-hover:scale-105"
                alt={`Gallery photo ${i + 1}`}
              />
            </div>
          ))}
        </div>
      )}
    </Container>
  </section>
)}
