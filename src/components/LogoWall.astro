---
interface Props {
  logos: string[];
}
const { logos } = Astro.props;
---
<div class="grid grid-cols-2 gap-px overflow-hidden rounded-2xl border border-border bg-border md:grid-cols-3 lg:grid-cols-6">
  {logos.map((name) => (
    <div data-reveal class="group flex h-32 items-center justify-center bg-base px-8 transition-colors duration-500 hover:bg-surface-2">
      <span class="font-display text-sm font-medium tracking-tight text-text-muted/60 transition-colors duration-500 group-hover:text-text-primary">
        {name}
      </span>
    </div>
  ))}
</div>
