---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import Container from '../components/Container.astro';
import { Button } from '../components/Button';
---
<Layout title="Page Not Found: ClickCulture Digital" description="The page you're looking for doesn't exist.">
  <main>
    <section class="relative flex min-h-screen items-center overflow-hidden pt-32 pb-32">
      <div class="pointer-events-none absolute inset-0 -z-10">
        <div class="absolute left-1/2 top-1/3 h-[60vh] w-[60vh] -translate-x-1/2 rounded-full bg-accent/20 blur-[160px]"></div>
      </div>
      <Container>
        <div class="max-w-2xl">
          <p class="mb-8 flex items-center gap-3 text-xs uppercase tracking-[0.22em] text-text-muted">
            <span class="inline-block h-px w-10 bg-text-muted"></span>
            404 · Page not found
          </p>
          <h1 class="font-display text-[clamp(2.5rem,6vw,5rem)] font-medium leading-[1.02] tracking-tight">
            This page doesn't <span class="text-accent-hover">exist.</span>
          </h1>
          <p class="mt-8 max-w-lg text-lg leading-relaxed text-text-muted">
            The page you're looking for may have moved, been renamed, or never existed. Let's get you back on track.
          </p>
          <div class="mt-12 flex flex-wrap items-center gap-4">
            <Button magnetic asChildHref="/" client:visible>Back to homepage</Button>
            <a href="/work" class="inline-flex items-center gap-2 text-sm text-text-muted transition-colors hover:text-text-primary">See our work →</a>
          </div>
        </div>
      </Container>
    </section>
  </main>
  <Footer />
</Layout>
