---
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer.astro';
import Container from '../../components/Container.astro';
import { Image } from 'astro:assets';
import { ArrowUpRight } from 'lucide-react';
import { CASE_STUDIES } from '../../data/case-studies';
import chipperImg from '../../assets/work/chipper.webp';
import lintonsImg from '../../assets/work/lintons.webp';
import unileverImg from '../../assets/work/unilever.webp';
import foodLibraryImg from '../../assets/work/food-library.webp';

const WORK_IMAGES: Record<string, ImageMetadata> = {
  "chipper-cash": chipperImg,
  lintons: lintonsImg,
  unilever: unileverImg,
  "food-library": foodLibraryImg,
};
---
<Layout title="Work: ClickCulture Digital" description="Marketing that drove demand, not just visibility.">
  <main>
    <section class="border-b border-border pb-16 pt-40">
      <Container>
        <p class="text-xs uppercase tracking-[0.22em] text-text-muted opacity-0 [animation:fade-in_0.8s_cubic-bezier(0.16,1,0.3,1)_0.1s_forwards]">Work</p>
        <h1 class="mt-6 font-display text-[clamp(3rem,7vw,6rem)] font-medium leading-[1.02] tracking-tight opacity-0 [animation:fade-in_1s_cubic-bezier(0.16,1,0.3,1)_0.3s_forwards]">
          Marketing that drove demand, <span class="text-accent-hover">not just visibility.</span>
        </h1>
      </Container>
    </section>
    {CASE_STUDIES.map((c, i) => {
      const index = i + 1;
      const n = String(index).padStart(2, "0");
      const isLight = index % 2 === 0;
      const isFlipped = index % 2 === 0;
      const image = WORK_IMAGES[c.slug];
      const toneClass = c.tone === "dark" ? "from-surface-2 to-base" : c.tone === "soft" ? "from-accent-soft to-surface-2" : "from-accent/40 to-surface-2";
      return (
        <section class:list={["border-t border-border py-24 md:py-32", isLight && "section-light"]}>
          <Container>
            <a href={`/work/${c.slug}`} class="group block">
              <div class="grid gap-12 lg:grid-cols-2 lg:items-center lg:gap-20">
                <div data-reveal class:list={["relative aspect-[4/3] w-full overflow-hidden rounded-2xl border border-border", `bg-gradient-to-br ${toneClass}`, "transition-colors duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:border-accent", isFlipped && "lg:order-2"]}>
                  {image ? (
                    <Image src={image} loading="lazy" quality={100} format="webp" width={800} class="absolute inset-0 h-full w-full object-cover" alt={c.client} />
                  ) : (
                    <div class="absolute inset-0 flex items-center justify-center">
                      <span class="font-display text-[clamp(5rem,10vw,8rem)] font-medium leading-none text-text-primary/10 transition-all duration-700 group-hover:text-text-primary/20">{c.initials}</span>
                    </div>
                  )}
                  <div class="absolute left-5 top-5 inline-flex items-center gap-2 rounded-full border border-border bg-base/60 px-3 py-1 text-[10px] font-medium uppercase tracking-[0.18em] text-text-muted backdrop-blur">{c.tag}</div>
                  <div class="absolute bottom-5 right-5 flex h-10 w-10 items-center justify-center rounded-full border border-border bg-base/60 backdrop-blur transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] opacity-0 group-hover:opacity-100 group-hover:border-accent group-hover:bg-accent">
                    <ArrowUpRight size={16} className="text-text-primary" />
                  </div>
                </div>
                <div data-reveal class:list={["flex flex-col gap-7", isFlipped && "lg:order-1"]}>
                  <div class="flex items-center gap-4">
                    <span class="font-display text-sm text-accent-hover">{n}</span>
                    <span class="h-px w-10 bg-border"></span>
                    <span class="text-xs uppercase tracking-[0.22em] text-text-muted">{c.tag}</span>
                  </div>
                  <h2 class="font-display text-[clamp(2rem,4vw,3.5rem)] font-medium leading-[1.05] tracking-tight text-text-primary">{c.client}</h2>
                  <p class="text-sm leading-relaxed text-text-muted">{c.descriptor}</p>
                  <p class="font-display text-lg font-medium text-accent-hover">{c.metric}</p>
                  <div class="flex items-center gap-2 pt-1 text-sm text-text-muted transition-colors duration-300 group-hover:text-text-primary">
                    View case study
                    <ArrowUpRight size={14} className="transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
                  </div>
                </div>
              </div>
            </a>
          </Container>
        </section>
      );
    })}
  </main>
  <Footer />
</Layout>
