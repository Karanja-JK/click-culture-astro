---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import Container from '../components/Container.astro';
import { Button } from '../components/Button';
import { ServicePanel } from '../components/ServicePanel';
import { SERVICES } from '../data/services';
---
<Layout title="Services: ClickCulture Digital" description="Four capabilities, one mandate: make your marketing work for real.">
  <main>
    <section class="border-b border-border pb-16 pt-40">
      <Container>
        <p class="text-xs uppercase tracking-[0.22em] text-text-muted opacity-0 [animation:fade-in_0.8s_cubic-bezier(0.16,1,0.3,1)_0.1s_forwards]">Services</p>
        <h1 class="mt-6 font-display text-[clamp(3rem,7vw,6rem)] font-medium leading-[1.02] tracking-tight opacity-0 [animation:fade-in_1s_cubic-bezier(0.16,1,0.3,1)_0.3s_forwards]">
          What we do, <span class="text-accent-hover">end to end.</span>
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-text-muted opacity-0 [animation:fade-in_1s_cubic-bezier(0.16,1,0.3,1)_0.5s_forwards]">
          Four capabilities, one mandate: make your marketing work for real.
        </p>
      </Container>
    </section>
    {SERVICES.map((s, i) => (
      <section id={s.slug} class:list={["border-t border-border scroll-mt-28 py-24 md:py-32", s.isLight && "section-light"]}>
        <Container>
          <ServicePanel panelIndex={i + 1} name={s.name} tagline={s.tagline} points={s.points} client:visible />
        </Container>
      </section>
    ))}
    <section class="border-t border-border py-24 md:py-32">
      <Container>
        <p class="max-w-3xl font-display text-[clamp(1.75rem,3.5vw,3rem)] font-medium italic leading-snug tracking-tight text-text-muted">
          We build the infrastructure that converts traffic into inquiries, <span class="text-text-primary not-italic">and inquiries into paying customers.</span>
        </p>
        <div class="mt-12">
          <Button magnetic asChildHref="/contact" client:visible>Book a Strategy Call</Button>
        </div>
      </Container>
    </section>
  </main>
  <Footer />
</Layout>
