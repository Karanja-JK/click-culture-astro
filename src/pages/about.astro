---
import Layout from '../layouts/Layout.astro';
import { Nav } from '../components/Nav';
import Footer from '../components/Footer.astro';
import Container from '../components/Container.astro';
import { Button } from '../components/Button';
import ProcessStep from '../components/ProcessStep.astro';
import WhyClickCulture from '../components/WhyClickCulture.astro';
import SectionHeader from '../components/SectionHeader.astro';

const BELIEFS = [
  { principle: "Attention ≠ Conversion", body: "Reach without intent is noise. We build marketing that earns consideration, not just impressions. Every piece of content has a commercial job to do." },
  { principle: "Reach Means Nothing", body: "The number of people who saw your content is not a business metric. We measure what moved: purchases made, inquiries sent, bookings completed." },
  { principle: "Chosen, Not Just Seen", body: "In a market full of content, the brand that wins is the one people actively seek out. We engineer that preference through strategy, creative, and relentless execution." },
];
---
<Layout title="About: ClickCulture Digital" description="We don't create content. We create demand. A Nairobi-based marketing agency built for commercial outcomes.">
  <Nav currentPath={Astro.url.pathname} client:load />
  <main>
    <section class="relative flex min-h-screen items-center overflow-hidden pb-20 pt-32">
      <div class="pointer-events-none absolute inset-0 -z-10">
        <div class="absolute left-1/3 top-1/3 h-[55vh] w-[55vh] -translate-x-1/2 rounded-full bg-accent/15 blur-[160px]"></div>
        <div class="absolute bottom-1/4 right-1/4 h-[30vh] w-[30vh] rounded-full bg-accent-hover/8 blur-[120px]"></div>
      </div>
      <Container>
        <p class="mb-10 flex items-center gap-3 text-xs uppercase tracking-[0.22em] text-text-muted opacity-0 [animation:fade-in_0.8s_cubic-bezier(0.16,1,0.3,1)_0.1s_forwards]">
          <span class="inline-block h-px w-10 bg-text-muted"></span>
          About ClickCulture Digital · Nairobi
        </p>
        <div class="max-w-5xl space-y-2">
          <h1 class="font-display text-[clamp(2.75rem,6.5vw,5.5rem)] font-medium leading-[1.04] tracking-tight text-text-muted opacity-0 [animation:fade-in_1s_cubic-bezier(0.16,1,0.3,1)_0.3s_forwards]">We don't create content.</h1>
          <p class="font-display text-[clamp(2.75rem,6.5vw,5.5rem)] font-medium leading-[1.04] tracking-tight text-text-primary opacity-0 [animation:fade-in_1s_cubic-bezier(0.16,1,0.3,1)_0.55s_forwards]">We create <span class="text-accent-hover">demand.</span></p>
          <p class="pt-3 font-display text-[clamp(2.75rem,6.5vw,5.5rem)] font-medium leading-[1.04] tracking-tight text-text-muted opacity-0 [animation:fade-in_1s_cubic-bezier(0.16,1,0.3,1)_0.8s_forwards]">We don't chase attention.</p>
          <p class="font-display text-[clamp(2.75rem,6.5vw,5.5rem)] font-medium leading-[1.04] tracking-tight text-text-primary opacity-0 [animation:fade-in_1s_cubic-bezier(0.16,1,0.3,1)_1.05s_forwards]">We make brands <span class="text-accent-hover">chosen.</span></p>
          <p class="pt-3 font-display text-[clamp(2.75rem,6.5vw,5.5rem)] font-medium leading-[1.04] tracking-tight text-text-primary opacity-0 [animation:fade-in_1s_cubic-bezier(0.16,1,0.3,1)_1.3s_forwards]">If it doesn't <span class="text-accent-hover">convert,</span> <span class="text-text-muted">we don't do it.</span></p>
        </div>
        <p class="mt-14 max-w-xl text-lg leading-relaxed text-text-muted opacity-0 [animation:fade-in_1s_cubic-bezier(0.16,1,0.3,1)_1.55s_forwards]">
          A Nairobi-based marketing and creative agency. We build the systems, content, and strategy that drive real action, conversion, and growth.
        </p>
      </Container>
    </section>
    <section class="border-y border-border section-light py-24 md:py-32">
      <Container>
        <SectionHeader eyebrow="Principles" title="What We" accent="Believe." class="mb-16 max-w-2xl" />
        <div class="grid gap-12 md:grid-cols-3">
          {BELIEFS.map((b) => (
            <div class="flex flex-col gap-5">
              <span class="h-px w-12 flex-shrink-0 bg-accent-hover"></span>
              <h3 class="font-display text-2xl font-medium leading-tight tracking-tight text-text-primary md:text-3xl">{b.principle}</h3>
              <p class="text-base leading-relaxed text-text-muted">{b.body}</p>
            </div>
          ))}
        </div>
        <div class="mt-20 flex items-center gap-6 border-t border-border pt-10">
          <span class="inline-block h-px w-16 flex-shrink-0 bg-accent-hover"></span>
          <p class="text-lg italic text-text-muted md:text-xl">If it doesn't drive demand, we don't do it.</p>
        </div>
      </Container>
    </section>
    <WhyClickCulture class="border-y border-border bg-surface/30" />
    <section class="border-b border-border py-24 md:py-32">
      <Container>
        <SectionHeader eyebrow="How we think" title="A process built for" accent="outcomes." class="mb-16 max-w-2xl" />
        <div class="mt-16 grid gap-12 sm:grid-cols-2 lg:grid-cols-4">
          <ProcessStep index={1} title="Drive Demand" description="We make people want what you sell, before they're ever pitched." />
          <ProcessStep index={2} title="Convert" description="We design the path from interest to action, ruthlessly." />
          <ProcessStep index={3} title="Scale" description="We build the systems that let what works happen, repeatedly." isLast={false} />
          <ProcessStep index={4} title="Optimize" description="We tune for compounding returns, not vanity metrics." isLast={true} />
        </div>
        <p class="mt-20 max-w-3xl font-display text-2xl italic leading-snug text-text-muted md:text-3xl">
          By the end of onboarding, every action is intentional, <span class="text-text-primary not-italic">not experimental.</span>
        </p>
      </Container>
    </section>
    <section class="border-t border-border section-light py-24 md:py-32">
      <Container>
        <div class="max-w-3xl space-y-10">
          <p class="text-xs uppercase tracking-[0.22em] text-text-muted">Work with us</p>
          <h2 class="font-display text-[clamp(2.25rem,5vw,4rem)] font-medium leading-[1.05] tracking-tight">
            Ready to stop being seen <br class="hidden md:block" /> and start being <span class="text-accent-hover">chosen?</span>
          </h2>
          <Button magnetic asChildHref="/contact" client:visible>Start a conversation</Button>
        </div>
      </Container>
    </section>
  </main>
  <Footer />
</Layout>
