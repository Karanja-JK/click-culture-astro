---
import Layout from '../layouts/Layout.astro';
import Container from '../components/Container.astro';
import { Button } from '../components/Button';
import { Nav } from '../components/Nav';
import ServiceCard from '../components/ServiceCard.astro';
import { SERVICES } from '../data/services';
import ProcessStep from '../components/ProcessStep.astro';
import LogoMarquee from '../components/LogoMarquee.astro';
import SectionHeader from '../components/SectionHeader.astro';
import WhyClickCulture from '../components/WhyClickCulture.astro';
import CTASection from '../components/CTASection.astro';
import WorkCard from '../components/WorkCard.astro';
import { StatBlock } from '../components/StatBlock';
import Footer from '../components/Footer.astro';
import { CASE_STUDIES } from '../data/case-studies';
import chipperImg from '../assets/work/chipper.webp';
import lintonsImg from '../assets/work/lintons.webp';
import unileverImg from '../assets/work/unilever.webp';
import foodLibraryImg from '../assets/work/food-library.webp';

const WORK_IMAGES: Record<string, string> = {
  "chipper-cash": chipperImg,
  lintons: lintonsImg,
  unilever: unileverImg,
  "food-library": foodLibraryImg,
};
const featuredWork = CASE_STUDIES.filter((c) => c.featured).map((c) => ({
  client: c.featuredClient ?? c.client,
  metric: c.featuredMetric ?? c.metric,
  tag: c.tag,
  initials: c.initials,
  tone: c.tone,
  to: `/work/${c.slug}`,
  image: WORK_IMAGES[c.slug],
}));
---
<Layout title="ClickCulture Digital: We don't create content. We create demand." description="A marketing and creative agency that builds marketing which drives action, conversion, and growth.">
  <Nav currentPath={Astro.url.pathname} client:load />
  <main>
    <section class="relative flex min-h-screen items-center overflow-hidden pt-32 pb-32 md:pb-40">
      <div class="pointer-events-none absolute inset-0 -z-10">
        <div class="absolute left-1/2 top-1/3 h-[60vh] w-[60vh] -translate-x-1/2 rounded-full bg-accent/20 blur-[160px]"></div>
        <div class="absolute bottom-0 right-0 h-[40vh] w-[40vh] rounded-full bg-accent-hover/10 blur-[140px]"></div>
      </div>
      <Container>
        <div class="max-w-5xl">
          <p class="mb-8 flex items-center gap-3 text-xs uppercase tracking-[0.22em] text-text-muted opacity-0 [animation:fade-in_0.8s_cubic-bezier(0.16,1,0.3,1)_0.1s_forwards]">
            <span class="inline-block h-px w-10 bg-text-muted"></span>
            ClickCulture Digital · Nairobi
          </p>
          <h1 class="font-display text-[clamp(3rem,8.5vw,8rem)] font-medium leading-[0.98] tracking-tight opacity-0 [animation:fade-in_1s_cubic-bezier(0.16,1,0.3,1)_0.25s_forwards]">
            We don't create content. <br />
            <span class="text-accent-hover">We create demand.</span>
          </h1>
          <p class="mt-10 max-w-2xl text-lg leading-relaxed text-text-muted opacity-0 [animation:fade-in_1s_cubic-bezier(0.16,1,0.3,1)_0.5s_forwards]">
            A marketing and creative agency focused on making brands commercially effective,
            building marketing that drives action, conversion, and growth.
          </p>
          <div class="mt-12 flex flex-wrap items-center gap-4 opacity-0 [animation:fade-in_1s_cubic-bezier(0.16,1,0.3,1)_0.7s_forwards]">
            <Button magnetic asChildHref="/contact" client:visible>
              Book a Strategy Call
            </Button>
            <a href="#services" class="inline-flex items-center gap-2 text-sm text-text-muted transition-colors hover:text-text-primary">
              See what we do ↓
            </a>
          </div>
        </div>
      </Container>
      <a
        href="#positioning"
        aria-label="Scroll down"
        class="absolute bottom-10 left-1/2 hidden -translate-x-1/2 flex-col items-center gap-2 text-xs uppercase tracking-[0.22em] text-text-muted md:flex opacity-0 [animation:fade-in_1s_cubic-bezier(0.16,1,0.3,1)_1.2s_forwards]"
      >
        Scroll
        <span class="block h-10 w-px animate-pulse bg-border"></span>
      </a>
    </section>
    <LogoMarquee />
    <section id="positioning" class="border-y border-border py-24 md:py-32">
      <Container>
        <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
          <SectionHeader eyebrow="Principles" title="What We" accent="Believe." />
        </div>
        <div class="mt-16 grid items-start gap-12 xl:grid-cols-3">
          <p data-reveal class="font-display text-xl font-medium leading-tight tracking-tight text-text-primary xl:text-2xl">
            Attention ≠ Conversion
          </p>
          <p data-reveal class="font-display text-xl font-medium leading-tight tracking-tight text-text-primary xl:text-2xl">
            Reach Means Nothing
          </p>
          <p data-reveal class="font-display text-xl font-medium leading-tight tracking-tight text-text-primary xl:text-2xl">
            Chosen, Not Just Seen
          </p>
        </div>
        <div data-reveal class="mt-20 flex items-center gap-6 border-t border-border pt-10">
          <span class="inline-block h-px w-16 bg-accent-hover"></span>
          <p class="text-lg italic text-text-muted md:text-xl">
            If it doesn't drive demand, we don't do it.
          </p>
        </div>
      </Container>
    </section>
    <section id="services" class="section-light py-24 md:py-32">
      <Container>
        <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
          <SectionHeader eyebrow="Services" title="What we do," accent="end to end." />
        </div>
        <div class="mt-16 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {SERVICES.map((s) => (
            <ServiceCard icon={s.icon} title={s.name} description={s.tagline} to="/services" hash={s.slug} />
          ))}
        </div>
      </Container>
    </section>
    <section class="border-t border-border py-24 md:py-32">
      <Container>
        <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
          <SectionHeader eyebrow="Featured Work" title="Brands that needed" accent="demand, not noise." />
        </div>
        <div class="mt-16 grid gap-10 sm:grid-cols-2 lg:gap-x-12 lg:gap-y-24">
          {featuredWork.map((w, i) => (
            <div class={i % 2 === 1 ? "lg:mt-24" : ""}>
              <WorkCard {...w} />
            </div>
          ))}
        </div>
      </Container>
    </section>
    <section class="border-t border-border section-light py-24 md:py-32">
      <Container>
        <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
          <SectionHeader eyebrow="Results" title="Numbers that" accent="moved the business." />
        </div>
        <div class="mt-16 grid gap-12 sm:grid-cols-2 lg:grid-cols-4">
          <StatBlock value={24} suffix="h" label="Sell-out speed" client:visible />
          <StatBlock value={5} suffix="×" label="Campaign sales" client:visible />
          <StatBlock value={80} suffix="%" label="Organic reach lift" client:visible />
          <StatBlock value={95} suffix="%" label="App download surge" client:visible />
        </div>
      </Container>
    </section>
    <section class="border-t border-border py-24 md:py-32">
      <Container>
        <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
          <SectionHeader eyebrow="How we think" title="A process built for" accent="outcomes." />
        </div>
        <div class="mt-16 grid gap-12 sm:grid-cols-2 lg:grid-cols-4">
          <ProcessStep index={1} title="Drive Demand" description="We make people want what you sell, before they're ever pitched." />
          <ProcessStep index={2} title="Convert" description="We design the path from interest to action, ruthlessly." />
          <ProcessStep index={3} title="Scale" description="We build the systems that let what works happen, repeatedly." isLast={false} />
          <ProcessStep index={4} title="Optimize" description="We tune for compounding returns, not vanity metrics." isLast={true} />
        </div>
        <p data-reveal class="mt-20 max-w-3xl font-display text-2xl italic leading-snug text-text-muted md:text-3xl">
          By the end of onboarding, every action is intentional, <span class="text-text-primary">not experimental.</span>
        </p>
      </Container>
    </section>
    <WhyClickCulture class="border-t border-border bg-surface/30" />
    <CTASection />
  </main>
  <Footer />
</Layout>
